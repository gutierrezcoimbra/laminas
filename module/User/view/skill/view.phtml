<?php
$title = 'Ver Skill';
$this->headTitle($title);

// Obtener datos de la skill de manera segura
$skillName = '';
$skillId = '';
$createdAt = '';
$updatedAt = '';

if ($this->skill) {
    if (method_exists($this->skill, 'getNombre')) {
        $skillName = $this->skill->getNombre();
        $skillId = $this->skill->getId();
        $createdAt = $this->skill->getCreatedAt();
        $updatedAt = $this->skill->getUpdatedAt();
    } elseif (isset($this->skill->nombre)) {
        $skillName = $this->skill->nombre;
        $skillId = $this->skill->id ?? '';
        $createdAt = $this->skill->createdAt ?? '';
        $updatedAt = $this->skill->updatedAt ?? '';
    } elseif (is_array($this->skill)) {
        $skillName = $this->skill['nombre'] ?? '';
        $skillId = $this->skill['id'] ?? '';
        $createdAt = $this->skill['createdAt'] ?? '';
        $updatedAt = $this->skill['updatedAt'] ?? '';
    }
}
?>

