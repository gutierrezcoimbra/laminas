<?php
$title = 'CVs de ' . $this->escapeHtml($user->getNombre() . ' ' . $user->getApellidos());
$this->headTitle($title);
?>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <h1><?= $title ?></h1>
            
            <div class="mb-3">
                <a href="<?= $this->url('user') ?>" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver a Usuarios
                </a>
            </div>

            <?php if (count($cvs) > 0): ?>
                <div class="row">
                    <?php foreach ($cvs as $cv): ?>
                        <div class="col-md-6 mb-4">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">
                                        <?= $this->escapeHtml($cv->getTitulo()) ?>
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <?php if ($cv->getResumen()): ?>
                                        <p class="card-text">
                                            <?= $this->escapeHtml(substr($cv->getResumen(), 0, 150)) ?>
                                            <?= strlen($cv->getResumen() ?? '') > 150 ? '...' : '' ?>
                                        </p>
                                    <?php endif; ?>
                                    
                                    <?php if (!empty($cv->getSkills())): ?>
                                        <div class="mb-3">
                                            <h6 class="text-muted mb-2">
                                                <i class="fas fa-tools"></i> Skills
                                            </h6>
                                            <div class="skills-container">
                                                <?php foreach (array_slice($cv->getSkills(), 0, 4) as $skill): ?>
                                                    <?php
                                                    $badgeClass = match($skill['nivel']) {
                                                        'basico' => 'badge-secondary',
                                                        'intermedio' => 'badge-info',
                                                        'avanzado' => 'badge-warning',
                                                        'experto' => 'badge-success',
                                                        default => 'badge-secondary'
                                                    };
                                                    ?>
                                                    <span class="badge <?= $badgeClass ?> me-1 mb-1" title="Nivel: <?= ucfirst($skill['nivel']) ?>">
                                                        <?= $this->escapeHtml($skill['nombre']) ?>
                                                    </span>
                                                <?php endforeach; ?>
                                                <?php if (count($cv->getSkills()) > 4): ?>
                                                    <span class="badge badge-light">+<?= count($cv->getSkills()) - 4 ?> más</span>
                                                <?php endif; ?>
                                            </div>
                                        </div>
                                    <?php endif; ?>
                                    
                                    <div class="text-muted small mb-3">
                                        <i class="fas fa-calendar"></i>
                                        Creado: <?= $cv->getCreatedAt() ? $cv->getCreatedAt()->format('d/m/Y H:i') : 'N/A' ?>
                                    </div>
                                    
                                    <a href="<?= $this->url('cvs/view', ['id' => $cv->getId()]) ?>" 
                                       class="btn btn-primary btn-sm">
                                        <i class="fas fa-eye"></i> Ver CV Completo
                                    </a>
                                </div>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
            <?php else: ?>
                <div class="alert alert-info">
                    <h4><i class="fas fa-info-circle"></i> Sin CVs</h4>
                    <p>Este usuario no tiene CVs registrados.</p>
                </div>
            <?php endif; ?>
        </div>
    </div>
</div>