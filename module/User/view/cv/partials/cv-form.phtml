<script>
document.addEventListener('DOMContentLoaded', function() {
    // Character counter for textareas
    const textareas = document.querySelectorAll('textarea[maxlength]');
    textareas.forEach(function(textarea) {
        const maxLength = parseInt(textarea.getAttribute('maxlength'));
        const counter = document.createElement('div');
        counter.className = 'char-counter';
        textarea.parentNode.appendChild(counter);
        
        function updateCounter() {
            const currentLength = textarea.value.length;
            counter.textContent = currentLength + '/' + maxLength + ' caracteres';
            
            // Color coding
            counter.className = 'char-counter';
            if (currentLength > maxLength * 0.9) {
                counter.classList.add('danger');
            } else if (currentLength > maxLength * 0.7) {
                counter.classList.add('warning');
            }
        }
        
        textarea.addEventListener('input', updateCounter);
        updateCounter(); // Initial count
    });
    
    // Skills Management V2 with Select2 and jQuery
    let skillsData = [];
    let editingSkillIndex = -1;
    
    // Available skills from server
    window.availableSkills = window.availableSkills || [];
    
    // Initialize Skills Manager
    function initSkillsManager() {
        // Load Select2 and jQuery if not already loaded
        if (typeof $ === 'undefined') {
            const jqueryScript = document.createElement('script');
            jqueryScript.src = 'https://code.jquery.com/jquery-3.6.0.min.js';
            jqueryScript.onload = function() {
                loadSelect2();
            };
            document.head.appendChild(jqueryScript);
        } else {
            loadSelect2();
        }
    }
    
    function loadSelect2() {
        if (typeof $.fn.select2 === 'undefined') {
            // Load Select2 CSS
            const select2CSS = document.createElement('link');
            select2CSS.rel = 'stylesheet';
            select2CSS.href = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css';
            document.head.appendChild(select2CSS);
            
            // Load Select2 JS
            const select2JS = document.createElement('script');
            select2JS.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
            select2JS.onload = function() {
                setupSkillsInterface();
            };
            document.head.appendChild(select2JS);
        } else {
            setupSkillsInterface();
        }
    }
    
    function setupSkillsInterface() {
        // Initialize Select2
        $('#skill-select2').select2({
            placeholder: '-- Seleccione una habilidad --',
            allowClear: true,
            data: window.availableSkills.map(skill => ({
                id: skill.id,
                text: skill.nombre
            }))
        });
        
        // Load existing skills
        loadExistingSkills();
        
        // Event listeners
        $('#add-skill-btn').on('click', addSkillToTable);
        
        // Update skills display
        updateSkillsTable();
    }
    
    function loadExistingSkills() {
        const skillsInput = document.getElementById('skills-data');
        if (skillsInput.value) {
            try {
                skillsData = JSON.parse(skillsInput.value) || [];
            } catch (e) {
                skillsData = [];
            }
        }
    }
    
    function addSkillToTable() {
        const skillId = $('#skill-select2').val();
        const skillText = $('#skill-select2 option:selected').text();
        const nivel = $('#skill-level-new').val();
        
        if (!skillId || !nivel) {
            alert('Por favor seleccione una habilidad y un nivel');
            return;
        }
        
        // Check if skill already exists
        if (skillsData.find(s => s.skill_id == skillId)) {
            alert('Esta habilidad ya está registrada');
            return;
        }
        
        // Add skill to data
        skillsData.push({
            skill_id: parseInt(skillId),
            nombre: skillText,
            nivel: nivel
        });
        
        // Reset form
        $('#skill-select2').val(null).trigger('change');
        $('#skill-level-new').val('basico');
        
        // Update table
        updateSkillsTable();
        updateHiddenField();
    }
    
    function updateSkillsTable() {
        const tbody = $('#skills-table-body');
        tbody.empty();
        
        if (skillsData.length === 0) {
            tbody.append(`
                <tr id="no-skills-row">
                    <td colspan="3" class="text-center text-muted py-4">
                        <i class="fas fa-info-circle me-1"></i>
                        No hay habilidades registradas
                    </td>
                </tr>
            `);
        } else {
            skillsData.forEach((skill, index) => {
                const row = `
                    <tr data-index="${index}">
                        <td class="skill-name-cell">
                            <span class="skill-name-display">${skill.nombre}</span>
                            <select class="skill-name-edit skill-edit-input" style="display: none;">
                                ${window.availableSkills.map(s => 
                                    `<option value="${s.id}" ${s.id == skill.skill_id ? 'selected' : ''}>${s.nombre}</option>`
                                ).join('')}
                            </select>
                        </td>
                        <td class="skill-level-cell">
                            <span class="skill-level-display">
                                <span class="skill-level-badge ${skill.nivel}">${skill.nivel.toUpperCase()}</span>
                            </span>
                            <select class="skill-level-edit skill-edit-select" style="display: none;">
                                <option value="basico" ${skill.nivel === 'basico' ? 'selected' : ''}>Básico</option>
                                <option value="intermedio" ${skill.nivel === 'intermedio' ? 'selected' : ''}>Intermedio</option>
                                <option value="avanzado" ${skill.nivel === 'avanzado' ? 'selected' : ''}>Avanzado</option>
                                <option value="experto" ${skill.nivel === 'experto' ? 'selected' : ''}>Experto</option>
                            </select>
                        </td>
                        <td class="skill-actions-cell text-center">
                            <div class="skill-actions">
                                <button type="button" class="skill-action-btn skill-edit-btn" onclick="editSkill(${index})">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="skill-action-btn skill-delete-btn" onclick="deleteSkill(${index})">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                            <div class="skill-edit-actions" style="display: none;">
                                <button type="button" class="skill-action-btn skill-save-btn" onclick="saveSkill(${index})">
                                    <i class="fas fa-save"></i>
                                </button>
                                <button type="button" class="skill-action-btn skill-cancel-btn" onclick="cancelEdit(${index})">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }
    }
    
    function updateHiddenField() {
        document.getElementById('skills-data').value = JSON.stringify(skillsData);
    }
    
    // Global functions for table actions
    window.editSkill = function(index) {
        const row = $(`tr[data-index="${index}"]`);
        
        // Hide display elements
        row.find('.skill-name-display, .skill-level-display').hide();
        row.find('.skill-actions').hide();
        
        // Show edit elements
        row.find('.skill-name-edit, .skill-level-edit').show();
        row.find('.skill-edit-actions').show();
        
        editingSkillIndex = index;
    };
    
    window.saveSkill = function(index) {
        const row = $(`tr[data-index="${index}"]`);
        
        const newSkillId = parseInt(row.find('.skill-name-edit').val());
        const newSkillName = row.find('.skill-name-edit option:selected').text();
        const newLevel = row.find('.skill-level-edit').val();
        
        // Check if skill already exists (excluding current one)
        const existingSkill = skillsData.find((s, i) => s.skill_id === newSkillId && i !== index);
        if (existingSkill) {
            alert('Esta habilidad ya está registrada');
            return;
        }
        
        // Update skill data
        skillsData[index] = {
            skill_id: newSkillId,
            nombre: newSkillName,
            nivel: newLevel
        };
        
        editingSkillIndex = -1;
        updateSkillsTable();
        updateHiddenField();
    };
    
    window.cancelEdit = function(index) {
        editingSkillIndex = -1;
        updateSkillsTable();
    };
    
    window.deleteSkill = function(index) {
        if (confirm('¿Está seguro de que desea eliminar esta habilidad?')) {
            skillsData.splice(index, 1);
            updateSkillsTable();
            updateHiddenField();
        }
    };
    
    // Initialize when DOM is ready
    initSkillsManager();
});
</script>
