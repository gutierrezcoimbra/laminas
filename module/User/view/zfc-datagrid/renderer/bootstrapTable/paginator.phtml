<?php
/**
 * Plantilla de paginación Bootstrap estándar para ZfcDatagrid
 */

// Verificar si tenemos la información necesaria para la paginación
if (!isset($pageCount) || !isset($current) || $pageCount <= 1) {
    return; // No mostrar nada si no hay datos de paginación o solo hay una página
}

// Variables de configuración
$currentPage = $current;
$totalPages = $pageCount;
?>

<nav aria-label="Page navigation">
  <ul class="pagination">
    <!-- Página anterior -->
    <?php if (isset($previous) && $previous): ?>
        <li class="page-item">
            <a class="page-link" 
               href="<?= $this->url(null, [], ['query' => array_merge($activeParameters, [$parameterNames['currentPage'] => $previous])], true) ?>" 
               aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
                <span class="sr-only">Previous</span>
            </a>
        </li>
    <?php else: ?>
        <li class="page-item disabled">
            <span class="page-link" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
                <span class="sr-only">Previous</span>
            </span>
        </li>
    <?php endif; ?>
    
    <!-- Páginas numeradas -->
    <?php 
    if (isset($pagesInRange) && is_array($pagesInRange)):
        foreach ($pagesInRange as $page): 
    ?>
        <li class="page-item <?= $page == $currentPage ? 'active' : '' ?>">
            <?php if ($page == $currentPage): ?>
                <span class="page-link" aria-current="page"><?= $page ?></span>
            <?php else: ?>
                <a class="page-link" 
                   href="<?= $this->url(null, [], ['query' => array_merge($activeParameters, [$parameterNames['currentPage'] => $page])], true) ?>">
                    <?= $page ?>
                </a>
            <?php endif; ?>
        </li>
    <?php 
        endforeach; 
    endif; 
    ?>
    
    <!-- Página siguiente -->
    <?php if (isset($next) && $next): ?>
        <li class="page-item">
            <a class="page-link" 
               href="<?= $this->url(null, [], ['query' => array_merge($activeParameters, [$parameterNames['currentPage'] => $next])], true) ?>" 
               aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
                <span class="sr-only">Next</span>
            </a>
        </li>
    <?php else: ?>
        <li class="page-item disabled">
            <span class="page-link" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
                <span class="sr-only">Next</span>
            </span>
        </li>
    <?php endif; ?>
  </ul>
</nav>
