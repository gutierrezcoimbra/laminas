<script>
document.addEventListener('DOMContentLoaded', function() {
    // Función para corregir enlaces de botones
    function fixActionButtons() {
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(function(row) {
            const firstCell = row.querySelector('td:first-child');
            if (firstCell) {
                const cvId = firstCell.textContent.trim();
                
                // Corregir enlaces si hay un ID válido
                if (cvId && /^\d+$/.test(cvId)) {
                    const links = row.querySelectorAll('a[href*=":cv_id"]');
                    links.forEach(function(link) {
                        link.href = link.href.replace(':cv_id', cvId);
                    });
                }
            }
        });
    }
    
    // Función para contar CVs y actualizar badge
    function updateCvCount() {
        const rows = document.querySelectorAll('tbody tr');
        const count = rows.length;
        const countElement = document.getElementById('total-cvs-count');
        if (countElement) {
            countElement.textContent = `Total: ${count} CV${count !== 1 ? 's' : ''}`;
        }
    }
    
    // Función para convertir skills en badges coloreados
    function formatSkillsBadges() {
        const rows = document.querySelectorAll('table.table tbody tr');
        
        rows.forEach(function(row, rowIndex) {
            const cells = row.querySelectorAll('td');
            
            // Buscar la columna de skills (debería contener texto con formato skill:nivel|skill:nivel)
            for (let i = 0; i < cells.length; i++) {
                const cellText = cells[i].textContent.trim();
                
                // Verificar si esta celda contiene skills (formato: palabra:nivel|palabra:nivel o palabra:nivel)
                if (cellText && cellText.includes(':') && (cellText.includes('|') || !cellText.includes(' '))) {
                    const skillsCell = cells[i];
                    const skills = cellText.split('|');
                    let badgesHtml = '<div class="skills-container">';
                    
                    skills.forEach(function(skill) {
                        if (skill && skill.includes(':')) {
                            const [skillName, level] = skill.split(':');
                            const badgeClass = getSkillBadgeClass(level.trim());
                            badgesHtml += `<span class="badge ${badgeClass} me-1 mb-1" title="${skillName}: ${level}">${skillName}</span>`;
                        }
                    });
                    
                    badgesHtml += '</div>';
                    skillsCell.innerHTML = badgesHtml;
                    break; // Salir del bucle una vez que encontremos la columna de skills
                }
            }
        });
    }
    

    
    // Función para obtener la clase CSS del badge según el nivel
    function getSkillBadgeClass(level) {
        switch(level.toLowerCase()) {
            case 'experto':
                return 'bg-success';
            case 'avanzado':
                return 'bg-primary';
            case 'intermedio':
                return 'bg-warning text-dark';
            case 'basico':
            case 'básico':
                return 'bg-secondary';
            default:
                return 'bg-light text-dark';
        }
    }
    
    // Función para mostrar alertas informativas
    function showInfo(message, type = 'success') {
        const alertElement = document.getElementById('datagrid-info');
        const messageElement = document.getElementById('alert-message');
        
        if (alertElement && messageElement) {
            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            messageElement.textContent = message;
            alertElement.classList.remove('d-none');
            
            // Auto-ocultar después de 3 segundos
            setTimeout(() => {
                alertElement.classList.add('d-none');
            }, 3000);
        }
    }
    
    // Función para formatear la columna de usuario (nombre + email)
    function formatUserInfoColumn() {
        const rows = document.querySelectorAll('table.table tbody tr');
        
        rows.forEach(function(row) {
            const cells = row.querySelectorAll('td');
            
            // Buscar la columna que contiene nombre\nemail
            for (let i = 0; i < cells.length; i++) {
                const cell = cells[i];
                const cellText = cell.textContent.trim();
                
                // Si contiene un salto de línea (\n) es probablemente la columna de usuario
                if (cellText && cellText.includes('\n')) {
                    const lines = cellText.split('\n');
                    if (lines.length >= 2) {
                        const nombre = lines[0].trim();
                        const email = lines[1].trim();
                        
                        cell.innerHTML = `<div class="user-info-column">
                            <strong>${nombre}</strong><br>
                            <small class="text-muted">${email}</small>
                        </div>`;
                        break;
                    }
                }
            }
        });
    }

    // Ejecutar funciones iniciales
    fixActionButtons();
    updateCvCount();
    formatSkillsBadges();
    formatUserInfoColumn();
    
    // Mostrar mensaje de carga exitosa
    setTimeout(() => {
        showInfo('Datos de CVs cargados correctamente.');
    }, 500);
    
    // También ejecutar después de un pequeño retraso por si el contenido se carga dinámicamente
    setTimeout(() => {
        fixActionButtons();
        updateCvCount();
        formatSkillsBadges();
        formatUserInfoColumn();
    }, 1000);
    
    // Inicializar tooltips de Bootstrap
    function initializeTooltips() {
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    }
    
    // Observar cambios en la tabla para actualizar el contador y reinicializar tooltips
    const observer = new MutationObserver(() => {
        updateCvCount();
        fixActionButtons();
        setTimeout(initializeTooltips, 100); // Reinicializar tooltips después de cambios
    });
    
    const tableContainer = document.querySelector('.zfcDatagrid-container');
    if (tableContainer) {
        observer.observe(tableContainer, { childList: true, subtree: true });
    }
    
    // Inicializar tooltips al cargar
    setTimeout(initializeTooltips, 1500);
});
</script>
