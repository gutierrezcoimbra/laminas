<script>
document.addEventListener('DOMContentLoaded', function() {
    // Función para corregir enlaces de botones
    function fixActionButtons() {
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(function(row) {
            const firstCell = row.querySelector('td:first-child');
            if (firstCell) {
                const userId = firstCell.textContent.trim();
                
                // Corregir enlaces si hay un ID válido
                if (userId && /^\d+$/.test(userId)) {
                    const links = row.querySelectorAll('a[href*=":user_id"]');
                    links.forEach(function(link) {
                        link.href = link.href.replace(':user_id', userId);
                    });
                }
            }
        });
    }
    
    // Función para contar usuarios y actualizar badge
    function updateUserCount() {
        const rows = document.querySelectorAll('tbody tr');
        const count = rows.length;
        const countElement = document.getElementById('total-users-count');
        if (countElement) {
            countElement.textContent = `Total: ${count} usuario${count !== 1 ? 's' : ''}`;
        }
    }

    // Función para formatear profesiones como lista
    function formatProfesiones() {
        const rows = document.querySelectorAll('tbody tr');
        
        rows.forEach(function(row, rowIndex) {
            const cells = row.querySelectorAll('td');
            
            // Debug específico para la primera fila
            if (rowIndex === 0) {
                console.log('Primera fila - contenido de celdas:', Array.from(cells).map(cell => cell.textContent.trim()));
            }
            
            // Buscar específicamente la columna de profesiones (índice 5: Nombre, Email, Edad, CVs, Profesiones)
            // O buscar por el contenido que parece ser profesiones
            cells.forEach(function(cell, index) {
                // Verificar si ya se aplicó el formato para evitar duplicados
                if (cell.querySelector('.profesiones-list')) {
                    return; // Ya está formateado, salir
                }
                
                const text = cell.textContent.trim();
                
                // Debug específico para la primera fila
                if (rowIndex === 0) {
                    console.log(`Primera fila - Celda ${index}: "${text}"`);
                }
                
                // Detectar la columna de profesiones de manera más específica
                // Excluir explícitamente columnas de acciones y otros elementos
                const isProfessionColumn = (
                    text !== 'Sin CVs registrados' && 
                    text !== '' && 
                    text.length > 3 &&
                    !text.includes('@') && // No es email
                    !/^\d+$/.test(text) && // No es solo números (edad)
                    !/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(text) && // No es fecha
                    !/^\d{4}-\d{2}-\d{2}$/.test(text) && // No es fecha ISO
                    !cell.querySelector('a') && // No contiene enlaces (botones de acción)
                    !cell.querySelector('button') && // No contiene botones
                    !cell.querySelector('.btn') && // No contiene elementos con clase btn
                    !cell.querySelector('i.fas') && // No contiene iconos de FontAwesome (botones)
                    !cell.closest('td:last-child') && // No es la última columna (acciones)
                    // Estrategia: si no es email, ni número, ni fecha, ni botones
                    (text.includes('|') || // Múltiples profesiones con separador
                     (text.length > 8 && // Texto descriptivo más largo
                      index >= 3 && index < cells.length - 1)) // No es la primera ni la última columna
                );
                
                if (isProfessionColumn) {
                    console.log('Texto encontrado en columna profesiones:', text); // Debug
                    console.log('Contiene |:', text.includes('|')); // Debug
                    
                    // Si contiene | es múltiple, si no es una sola profesión
                    let profesiones = [];
                    if (text.includes('|')) {
                        profesiones = text.split('|').map(p => p.trim()).filter(p => p !== '');
                    } else {
                        profesiones = [text.trim()];
                    }
                    
                    console.log('Profesiones detectadas:', profesiones); // Debug
                    
                    if (profesiones.length > 0) {
                        // Crear lista HTML (igual para una o múltiples profesiones)
                        const ul = document.createElement('ul');
                        ul.className = 'list-unstyled mb-0 profesiones-list';
                        
                        profesiones.forEach(function(profesion, index) {
                            const li = document.createElement('li');
                            li.className = 'profesion-item';
                            li.innerHTML = `<i class="fas fa-briefcase me-1 text-primary"></i> ${profesion.trim()}`;
                            ul.appendChild(li);
                            console.log(`Profesión ${index + 1}: ${profesion.trim()} - HTML: ${li.innerHTML}`); // Debug
                            console.log(`Elemento li creado:`, li); // Debug adicional
                        });
                        
                        // Reemplazar el contenido de la celda
                        cell.innerHTML = '';
                        cell.appendChild(ul);
                    }
                }
            });
        });
    }
    
    // Función para mostrar alertas informativas
    function showInfo(message, type = 'info') {
        const alertElement = document.getElementById('datagrid-info');
        const messageElement = document.getElementById('alert-message');
        
        if (alertElement && messageElement) {
            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            messageElement.textContent = message;
            alertElement.classList.remove('d-none');
            
            // Auto-ocultar después de 3 segundos
            setTimeout(() => {
                alertElement.classList.add('d-none');
            }, 3000);
        }
    }
    
    // Ejecutar funciones iniciales
    fixActionButtons();
    updateUserCount();
    formatProfesiones();
    
    // Mostrar mensaje de carga exitosa
    setTimeout(() => {
        showInfo('Datos de usuarios cargados correctamente.');
    }, 500);
    
    // También ejecutar después de un pequeño retraso por si el contenido se carga dinámicamente
    setTimeout(() => {
        fixActionButtons();
        updateUserCount();
        formatProfesiones();
    }, 1000);
    
    // Ejecutar múltiples veces para asegurar que se aplique después de cualquier re-renderizado
    setTimeout(() => {
        formatProfesiones();
    }, 2000);
    
    setTimeout(() => {
        formatProfesiones();
    }, 3000);
    
    // Tooltips deshabilitados para evitar errores de Popper.js
    // Se mantiene el title attribute para mostrar información al hacer hover
    function initializeTooltips() {
        // Función vacía - tooltips deshabilitados
    }
    
    // Observar cambios en la tabla para actualizar el contador
    const observer = new MutationObserver((mutations) => {
        let shouldUpdate = false;
        mutations.forEach(mutation => {
            if (mutation.type === 'childList' || mutation.type === 'characterData') {
                shouldUpdate = true;
            }
        });
        
        if (shouldUpdate) {
            console.log('Detectado cambio en el DOM, re-aplicando formato...'); // Debug
            setTimeout(() => {
                updateUserCount();
                fixActionButtons();
                formatProfesiones();
            }, 100);
        }
    });
    
    // Observar múltiples contenedores
    const containers = [
        '.zfcDatagrid-container',
        '.table-responsive',
        'tbody',
        '.zfcDatagrid'
    ];
    
    containers.forEach(selector => {
        const container = document.querySelector(selector);
        if (container) {
            observer.observe(container, { 
                childList: true, 
                subtree: true, 
                characterData: true,
                attributes: true 
            });
        }
    });
    
    // Inicializar tooltips al cargar
    setTimeout(initializeTooltips, 1500);
});
</script>

