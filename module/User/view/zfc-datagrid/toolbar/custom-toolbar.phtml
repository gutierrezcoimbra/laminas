<script>
document.addEventListener('DOMContentLoaded', function() {
    // Función para corregir enlaces de botones
    function fixActionButtons() {
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(function(row) {
            const firstCell = row.querySelector('td:first-child');
            if (firstCell) {
                const userId = firstCell.textContent.trim();
                
                // Corregir enlaces si hay un ID válido
                if (userId && /^\d+$/.test(userId)) {
                    const links = row.querySelectorAll('a[href*=":id"]');
                    links.forEach(function(link) {
                        link.href = link.href.replace(':id', userId);
                    });
                }
            }
        });
    }
    
    // Función para contar usuarios y actualizar badge
    function updateUserCount() {
        const rows = document.querySelectorAll('tbody tr');
        const count = rows.length;
        const countElement = document.getElementById('total-users-count');
        if (countElement) {
            countElement.textContent = `Total: ${count} usuario${count !== 1 ? 's' : ''}`;
        }
    }
    
    // Función para mostrar alertas informativas
    function showInfo(message, type = 'info') {
        const alertElement = document.getElementById('datagrid-info');
        const messageElement = document.getElementById('alert-message');
        
        if (alertElement && messageElement) {
            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            messageElement.textContent = message;
            alertElement.classList.remove('d-none');
            
            // Auto-ocultar después de 3 segundos
            setTimeout(() => {
                alertElement.classList.add('d-none');
            }, 3000);
        }
    }
    
    // Ejecutar funciones iniciales
    fixActionButtons();
    updateUserCount();
    
    // Mostrar mensaje de carga exitosa
    setTimeout(() => {
        showInfo('Datos de usuarios cargados correctamente.');
    }, 500);
    
    // También ejecutar después de un pequeño retraso por si el contenido se carga dinámicamente
    setTimeout(() => {
        fixActionButtons();
        updateUserCount();
    }, 1000);
    
    // Inicializar tooltips de Bootstrap
    function initializeTooltips() {
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    }
    
    // Observar cambios en la tabla para actualizar el contador y reinicializar tooltips
    const observer = new MutationObserver(() => {
        updateUserCount();
        fixActionButtons();
        setTimeout(initializeTooltips, 100); // Reinicializar tooltips después de cambios
    });
    
    const tableContainer = document.querySelector('.zfcDatagrid-container');
    if (tableContainer) {
        observer.observe(tableContainer, { childList: true, subtree: true });
    }
    
    // Inicializar tooltips al cargar
    setTimeout(initializeTooltips, 1500);
});
</script>

