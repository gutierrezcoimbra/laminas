<script>
document.addEventListener('DOMContentLoaded', function() {
    // Función para corregir enlaces de botones
    function fixActionButtons() {
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(function(row) {
            const firstCell = row.querySelector('td:first-child');
            if (firstCell) {
                const skillId = firstCell.textContent.trim();
                
                // Corregir enlaces si hay un ID válido
                if (skillId && /^\d+$/.test(skillId)) {
                    const links = row.querySelectorAll('a[href*=":id"]');
                    links.forEach(function(link) {
                        link.href = link.href.replace(':id', skillId);
                    });
                }
            }
        });
    }
    
    // Función para contar skills y actualizar badge
    function updateSkillCount() {
        const rows = document.querySelectorAll('tbody tr');
        const count = rows.length;
        const countElement = document.getElementById('total-skills-count');
        if (countElement) {
            countElement.textContent = `Total: ${count} skill${count !== 1 ? 's' : ''}`;
        }
    }
    
    // Función para mostrar alertas informativas
    function showInfo(message, type = 'info') {
        const alertElement = document.getElementById('datagrid-info');
        const messageElement = document.getElementById('alert-message');
        
        if (alertElement && messageElement) {
            alertElement.className = `alert alert-${type} alert-dismissible fade show`;
            messageElement.textContent = message;
            alertElement.classList.remove('d-none');
            
            // Auto-ocultar después de 3 segundos
            setTimeout(() => {
                alertElement.classList.add('d-none');
            }, 3000);
        }
    }
    
    // Ejecutar funciones iniciales
    fixActionButtons();
    updateSkillCount();
    
    // Mostrar mensaje de carga exitosa
    setTimeout(() => {
        showInfo('Datos de skills cargados correctamente.');
    }, 500);
    
    // También ejecutar después de un pequeño retraso por si el contenido se carga dinámicamente
    setTimeout(() => {
        fixActionButtons();
        updateSkillCount();
    }, 1000);
    
    // Observar cambios en la tabla para actualizar el contador
    const observer = new MutationObserver((mutations) => {
        let shouldUpdate = false;
        mutations.forEach(mutation => {
            if (mutation.type === 'childList' || mutation.type === 'characterData') {
                shouldUpdate = true;
            }
        });
        
        if (shouldUpdate) {
            setTimeout(() => {
                updateSkillCount();
                fixActionButtons();
            }, 100);
        }
    });
    
    // Observar múltiples contenedores
    const containers = [
        '.zfcDatagrid-container',
        '.table-responsive',
        'tbody',
        '.zfcDatagrid'
    ];
    
    containers.forEach(selector => {
        const container = document.querySelector(selector);
        if (container) {
            observer.observe(container, { 
                childList: true, 
                subtree: true, 
                characterData: true,
                attributes: true 
            });
        }
    });
});
</script>
