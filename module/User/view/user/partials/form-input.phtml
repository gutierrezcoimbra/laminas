<?php
/**
 * Partial para renderizar un input del formulario
 * @var \Laminas\Form\Element $element Elemento del formulario
 * @var array $errors Errores del formulario
 */
$elementName = $element->getName();
$hasErrors = isset($errors[$elementName]) && !empty($errors[$elementName]);
?>

<div class="row mb-3">
    <div class="col-sm-2">
        <?= $this->formLabel($element); ?>
    </div>
    <div class="col-sm-10">
        <?= $this->formElement($element); ?>
        <?php if ($hasErrors): ?>
            <?= $this->formElementErrors($element, ['class' => 'text-danger small']); ?>
        <?php endif; ?>
    </div>
</div> 