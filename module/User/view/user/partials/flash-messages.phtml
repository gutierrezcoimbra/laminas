<?php
/**
 * Partial para renderizar mensajes flash
 */
?>

<?php if (isset($this->flashMessenger)): ?>
    <?php foreach ($this->flashMessenger()->getCurrentSuccessMessages() as $message): ?>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <?= $this->escapeHtml($message) ?>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <?php endforeach; ?>
    
    <?php foreach ($this->flashMessenger()->getCurrentErrorMessages() as $message): ?>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <?= $this->escapeHtml($message) ?>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <?php endforeach; ?>
    
    <?php foreach ($this->flashMessenger()->getCurrentInfoMessages() as $message): ?>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <?= $this->escapeHtml($message) ?>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <?php endforeach; ?>
    
    <?php foreach ($this->flashMessenger()->getCurrentWarningMessages() as $message): ?>
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <?= $this->escapeHtml($message) ?>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <?php endforeach; ?>
<?php endif; ?> 