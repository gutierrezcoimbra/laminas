<?php
/**
 * Vista para mostrar la lista de usuarios
 * @var array $users Lista de usuarios
 */
?>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Lista de Usuarios</h1>
            
            <?= $this->partial('user/partials/flash-messages'); ?>
            
            <div class="mb-3">
                <a href="<?= $this->url('user/add') ?>" class="btn btn-success">
                    <i class="fas fa-plus"></i> Agregar Nuevo Usuario
                </a>
            </div>
            
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Usuarios Registrados</h5>
                </div>
                <div class="card-body">
                    <?php if (empty($users)): ?>
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No hay usuarios registrados.
                        </div>
                    <?php else: ?>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Nombre Completo</th>
                                        <th>Email</th>
                                        <th>Fecha Nacimiento</th>
                                        <th>Edad</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <?php foreach ($users as $user): ?>
                                        <tr class="<?= $user->isDeleted() ? 'table-danger' : '' ?>">
                                            <td><?= $this->escapeHtml($user->getId()) ?></td>
                                            <td><?= $this->escapeHtml($user->getNombreCompleto()) ?></td>
                                            <td><?= $this->escapeHtml($user->getEmail()) ?></td>
                                            <td>
                                                <?php if ($user->getFechaNacimiento()): ?>
                                                    <?= $this->escapeHtml($user->getFechaNacimiento()->format('d/m/Y')) ?>
                                                <?php else: ?>
                                                    <span class="text-muted">No especificada</span>
                                                <?php endif; ?>
                                            </td>
                                            <td>
                                                <?php if ($user->getEdad() !== null): ?>
                                                    <?= $this->escapeHtml($user->getEdad()) ?> años
                                                <?php else: ?>
                                                    <span class="text-muted">-</span>
                                                <?php endif; ?>
                                            </td>
                                            <td>
                                                <?php if ($user->isDeleted()): ?>
                                                    <span class="text-danger">Eliminado</span>
                                                <?php else: ?>
                                                    <span class="text-success">Activo</span>
                                                <?php endif; ?>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                                                                         <a href="<?= $this->url('user/view', ['id' => $user->getId()]) ?>" 
                                                        class="btn btn-sm btn-info" title="Ver">
                                                         Ver
                                                     </a>
                                                    <?php if (!$user->isDeleted()): ?>
                                                                                                                 <a href="<?= $this->url('user/edit', ['id' => $user->getId()]) ?>" 
                                                            class="btn btn-sm btn-warning" title="Editar">
                                                             Editar
                                                         </a>
                                                                                                                 <a href="<?= $this->url('user/delete', ['id' => $user->getId()]) ?>" 
                                                            class="btn btn-sm btn-danger" title="Eliminar">
                                                             Eliminar
                                                         </a>
                                                    <?php endif; ?>
                                                </div>
                                            </td>
                                        </tr>
                                    <?php endforeach; ?>
                                </tbody>
                            </table>
                        </div>
                    <?php endif; ?>
                </div>
            </div>
        </div>
    </div>
</div> 